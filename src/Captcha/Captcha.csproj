<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Basical.Modules.Tools.Cache" Version="1.0.12" />
        <PackageReference Include="CityDi.Common.Core" Version="1.0.41" />
        <PackageReference Include="SkiaSharp" Version="4.153.1"/>
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.153.1"/>
        <PackageReference Include="Swashbuckle.AspNetCore.Swagger" Version="10.3.0"/>
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.0"/>
        <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.0"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\.dockerignore">
            <Link>.dockerignore</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <None Update="fonts\**\*.ttf">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </None>
    </ItemGroup>

</Project>
